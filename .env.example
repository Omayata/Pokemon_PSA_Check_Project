# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ไม่ถูก commit)
ROBOFLOW_API_KEY=your_roboflow_api_key

# ตอนรันบนเครื่อง (นอก Docker) ให้ชี้ไปที่ service ใน docker compose
MLFLOW_TRACKING_URI=http://localhost:5000
PREFECT_API_URL=http://localhost:4200/api
API_URL=http://localhost:8000

# (ไม่บังคับ) Discord/Slack webhook สำหรับส่งการแจ้งเตือน
ALERT_WEBHOOK_URL=
